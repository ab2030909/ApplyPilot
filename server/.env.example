# --- Required -------------------------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional -------------------------------------------------------------
# Any chat model available on your Groq account (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b
PORT=8787
HOST=0.0.0.0
# "production" turns off localhost CORS by default and enables extra warnings
NODE_ENV=development

# Lock the API to your published extension ID(s), comma separated.
# Find the ID at chrome://extensions. Leave empty to allow any extension (dev only).
ALLOWED_EXTENSION_IDS=
# Extra allowed browser origins, comma separated (e.g. https://my-dashboard.example.com)
ALLOWED_ORIGINS=
# Allow http://localhost:* origins (default: true in development, false in production)
ALLOW_LOCALHOST=
# Set to 1 when running behind a reverse proxy / PaaS (Render, Railway, Fly, Nginx)
TRUST_PROXY=
# Requests per minute per IP on /api (default 40)
RATE_LIMIT_PER_MINUTE=40
