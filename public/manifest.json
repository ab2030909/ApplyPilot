{
  "manifest_version": 3,
  "name": "ApplyPilot AI",
  "version": "1.0.0",
  "description": "Autofill job applications, analyze job descriptions and track applications. Your data stays local.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "ApplyPilot AI",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "index.html", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://localhost:8787/*", "http://127.0.0.1:8787/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
